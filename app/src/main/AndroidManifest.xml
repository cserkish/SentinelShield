<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════════════════════
         NORMAL PERMISSIONS
    ═══════════════════════════════════════════════════════════ -->

    <!-- Antivirus: query all installed packages for scanning -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Antivirus: receive package install/update events & restart on reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Network guard: create local loopback DNS VPN tunnel -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Foreground service for AppLock monitor and Local VPN -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Post notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ═══════════════════════════════════════════════════════════
         DANGEROUS PERMISSIONS
    ═══════════════════════════════════════════════════════════ -->

    <!-- IntruderSelfie: camera snapshot on failed unlock while lock screen is active -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ═══════════════════════════════════════════════════════════
         SPECIAL PERMISSIONS
    ═══════════════════════════════════════════════════════════ -->

    <!-- AppLock: detect foreground app -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- AppLock overlay: show lock screen on top of other apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ═══════════════════════════════════════════════════════════
         HARDWARE FEATURES
    ═══════════════════════════════════════════════════════════ -->
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />

    <application
        android:name=".SentinelApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SentinelShield"
        tools:targetApi="35">

        <!-- ───── Main Activity ───── -->
        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SentinelShield.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ───── AppLock Monitor Service ───── -->
        <service
            android:name=".service.AppMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="AppLock monitor using UsageStats to protect user-selected apps with a lock screen overlay" />
        </service>

        <!-- ───── Local VPN Service (Anti-Phishing DNS) ───── -->
        <service
            android:name=".service.PhishingVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- ───── Notification Listener (Safe Phishing Link Scanner) ───── -->
        <service
            android:name=".service.SmsPhishingListenerService"
            android:exported="true"
            android:label="@string/service_notification_listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- ───── Boot Receiver (restarts monitoring on device reboot) ───── -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- ───── Service Watchdog (JobScheduler) ───── -->
        <service
            android:name=".service.ServiceWatchdog"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

    </application>

</manifest>
