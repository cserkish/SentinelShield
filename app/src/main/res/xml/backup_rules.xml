<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="datastore" />
    <!-- Matches DatabaseModule.kt database name: sentinel_shield.db -->
    <exclude domain="database" path="sentinel_shield.db" />
    <exclude domain="database" path="sentinel_shield.db-shm" />
    <exclude domain="database" path="sentinel_shield.db-wal" />
    <!-- Matches IntruderSelfieManager.kt folder name: intruder -->
    <exclude domain="file" path="intruder" />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
