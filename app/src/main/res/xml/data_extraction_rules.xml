<?xml version="1.0" encoding="utf-8"?>
<!--
    SentinelShield — Data Extraction Rules
    Android 12 (API 31)+ uchun cloud backup va device-to-device transfer qoidalari.
    Barcha shaxsiy ma'lumotlar chiqarilgan.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Cloud backupga hech narsa yuklanmaydi -->
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>

    <device-transfer>
        <!-- Qurilmadan qurilmaga o'tkazishda ham hech narsa ko'chirilmaydi -->
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
